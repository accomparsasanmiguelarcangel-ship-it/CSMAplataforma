{
  "name": "Comparsa San Miguel Arcángel 2004",
  "short_name": "Arcángel 2004",
  "description": "Plataforma institucional de la Asociación Cultural Comparsa San Miguel Arcángel 2004: inscripciones, pagos por Yape, credencial QR, asistencia y documentación.",
